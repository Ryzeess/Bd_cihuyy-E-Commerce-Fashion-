// ========================================================
// DBML SCHEMA: FASHION E-COMMERCE (3 TABEL UTAMA)
// File: database/Fashion ecommers cihuy.dbml
// ========================================================

// --------------------------------------------------------
// 1. Tabel Users (Pelanggan / Pengguna)
// Menyimpan data akun pengguna yang berbelanja pakaian/fashion
// --------------------------------------------------------
Table users {
  id bigint [pk, increment]
  nama varchar(255) [not null]
  email varchar(255) [unique, not null]
  password varchar(255) [not null]
  no_telp varchar(20) [null, note: 'Nomor telepon/WhatsApp pelanggan']
  alamat text [null, note: 'Alamat pengiriman pakaian/barang']
  tanggal_daftar timestamp [default: `now()`]

  Note: 'Tabel utama data pembeli/pelanggan fashion e-commerce'
}

// --------------------------------------------------------
// 2. Tabel Products (Produk Fashion)
// Menyimpan katalog pakaian, celana, jaket, dan apparel lainnya
// --------------------------------------------------------
Table products {
  id bigint [pk, increment]
  nama_produk varchar(255) [not null]
  kategori varchar(100) [not null, note: 'Contoh: Kaos, Kemeja, Celana, Jaket, Hoodie']
  deskripsi text [null]
  harga decimal(12, 2) [not null, note: 'Harga produk per satuan (Rupiah)']
  stok integer [not null, default: 0, note: 'Jumlah stok barang yang tersedia']
  ukuran varchar(50) [null, note: 'Ukuran fashion: S, M, L, XL, XXL, All Size']
  warna varchar(50) [null, note: 'Varian warna: Hitam, Putih, Navy, Sage, dll']
  created_at timestamp [default: `now()`]

  Note: 'Tabel katalog produk fashion'
}

// --------------------------------------------------------
// 3. Tabel Orders (Pesanan / Transaksi Pembelian)
// Menghubungkan pembeli (users) dengan produk yang dibeli (products)
// --------------------------------------------------------
Table orders {
  id bigint [pk, increment]
  user_id bigint [not null, note: 'Foreign key merujuk ke users.id']
  product_id bigint [not null, note: 'Foreign key merujuk ke products.id']
  jumlah integer [not null, default: 1, note: 'Jumlah item pakaian yang dibeli']
  total_harga decimal(12, 2) [not null, note: 'Total biaya pembelian']
  status_pesanan varchar(50) [default: 'pending', note: 'Status: pending | diproses | dikirim | selesai | dibatalkan']
  metode_pembayaran varchar(50) [not null, note: 'Metode: transfer_bank | cod | e-wallet']
  tanggal_pesanan timestamp [default: `now()`]

  Note: 'Tabel transaksi pemesanan produk fashion oleh pelanggan'
}

// --------------------------------------------------------
// Relasi Antar Tabel (Relationships)
// --------------------------------------------------------

// Relasi 1: Satu user dapat melakukan banyak transaksi pesanan
Ref: users.id < orders.user_id [delete: cascade]

// Relasi 2: Satu produk dapat dibeli di dalam banyak transaksi pesanan
Ref: products.id < orders.product_id [delete: cascade]
