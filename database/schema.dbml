// ========================================================
// DBML SCHEMA: FASHION E-COMMERCE (SKEMA BRD v2.0 - 3 TABEL PERTAMA)
// File: database/Fashion ecommers v2.dbml
// Sesuai dengan Business Requirement Document (BRD) Minggu 2
// ========================================================

// --------------------------------------------------------
// 1. Tabel Produk
// Menyimpan informasi katalog pakaian/fashion
// --------------------------------------------------------
Table produk {
  id_produk int [pk, increment, note: 'Primary Key, ID Produk']
  id_kategori int [not null, note: 'Foreign Key ke tabel kategori']
  nama_produk varchar(150) [not null, note: 'Nama produk pakaian']
  deskripsi text [null, note: 'Deskripsi produk']
  harga decimal(12, 2) [not null, note: 'Harga produk']
  bahan varchar(50) [null, note: 'Bahan pakaian: Katun, Linen, Denim, dll']
  gaya varchar(50) [null, note: 'Gaya pakaian: Casual, Formal, dll']
  berat int [not null, note: 'Berat produk dalam satuan gram untuk ongkos kirim']

  Note: 'Tabel produk pakaian sesuai spesifikasi BRD'
}

// --------------------------------------------------------
// 2. Tabel Varian Produk
// Menyimpan kombinasi warna & ukuran serta stok real-time
// --------------------------------------------------------
Table varian_produk {
  id_varian int [pk, increment, note: 'Primary Key, ID Varian']
  id_produk int [not null, note: 'Foreign Key ke tabel produk']
  id_warna int [not null, note: 'Foreign Key ke tabel warna']
  id_ukuran int [not null, note: 'Foreign Key ke tabel ukuran']
  kode_barang varchar(50) [unique, not null, note: 'Kode SKU barang']
  stok int [not null, default: 0, note: 'Jumlah stok tersedia']

  Note: 'Tabel varian produk untuk mengelola stok per ukuran & warna'
}

// --------------------------------------------------------
// 3. Tabel Pelanggan
// Menyimpan data akun dan identitas pembeli
// --------------------------------------------------------
Table pelanggan {
  id_pelanggan int [pk, increment, note: 'Primary Key, ID Pelanggan']
  nama varchar(100) [not null, note: 'Nama pelanggan']
  email varchar(100) [unique, not null, note: 'Email pelanggan']
  password varchar(255) [not null, note: 'Password akun terenkripsi']
  no_telepon varchar(20) [null, note: 'Nomor telepon pelanggan']
  alamat text [null, note: 'Alamat pelanggan']
  tanggal_daftar datetime [default: `now()`, note: 'Waktu pelanggan mendaftar']

  Note: 'Tabel data pelanggan/pembeli sesuai spesifikasi BRD'
}

// --------------------------------------------------------
// Relasi Antar Tabel (Relationships)
// --------------------------------------------------------

// Relasi: Satu produk memiliki banyak varian (ukuran & warna)
Ref: produk.id_produk < varian_produk.id_produk [delete: cascade]
