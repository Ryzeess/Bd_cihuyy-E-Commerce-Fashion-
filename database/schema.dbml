// ========================================================
// DBML (Database Markup Language)
// Proyek: Cihuy Store (E-Commerce & Transaksi)
// Buka https://dbdiagram.io dan paste kode ini untuk melihat diagramnya
// ========================================================

Project cihuy_store {
  database_type: 'MySQL'
  Note: '''
    # Database Cihuy Store
    Skema database lengkap untuk sistem Toko Online / E-Commerce
    Mendukung manajemen user, profil, kategori, produk, pesanan, dan pembayaran.
  '''
}

// --------------------------------------------------------
// ENUMS (Tipe Data Pilihan)
// --------------------------------------------------------
Enum user_role {
  admin
  staff
  customer
}

Enum order_status {
  pending
  paid
  processing
  shipped
  delivered
  cancelled
}

Enum payment_method {
  bank_transfer
  qris
  e_wallet
  credit_card
  cod
}

Enum payment_status {
  unpaid
  paid
  failed
  refunded
}

// --------------------------------------------------------
// TABEL: USERS & PROFILES
// --------------------------------------------------------
Table users {
  id integer [primary key, increment]
  name varchar(100) [not null]
  email varchar(150) [unique, not null]
  password varchar(255) [not null]
  role user_role [default: 'customer']
  created_at timestamp [default: `now()`]
  updated_at timestamp

  Note: 'Tabel pengguna (admin, staf, pembeli)'
}

Table user_profiles {
  id integer [primary key, increment]
  user_id integer [unique, not null, ref: - users.id] // One-to-One
  phone varchar(20)
  address text
  city varchar(100)
  postal_code varchar(10)
  avatar_url varchar(255)

  Note: 'Detail biodata tambahan user (Relasi 1:1)'
}

// --------------------------------------------------------
// TABEL: KATALOG PRODUK
// --------------------------------------------------------
Table categories {
  id integer [primary key, increment]
  name varchar(100) [not null]
  slug varchar(120) [unique, not null]
  description text
  created_at timestamp [default: `now()`]

  Note: 'Kategori pengelompokan produk'
}

Table products {
  id integer [primary key, increment]
  category_id integer [not null, ref: > categories.id] // Many-to-One
  name varchar(150) [not null]
  slug varchar(180) [unique, not null]
  description text
  price decimal(12,2) [not null, default: 0.00]
  stock integer [not null, default: 0]
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp

  indexes {
    category_id
    price
    is_active
  }

  Note: 'Daftar produk yang dijual'
}

// --------------------------------------------------------
// TABEL: TRANSAKSI & PESANAN
// --------------------------------------------------------
Table orders {
  id integer [primary key, increment]
  order_code varchar(30) [unique, not null]
  user_id integer [not null, ref: > users.id] // Many-to-One
  total_amount decimal(12,2) [not null, default: 0.00]
  status order_status [default: 'pending']
  shipping_address text [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp

  indexes {
    user_id
    status
    order_code
  }

  Note: 'Header transaksi pesanan user'
}

Table order_items {
  id integer [primary key, increment]
  order_id integer [not null, ref: > orders.id] // Relasi ke orders
  product_id integer [not null, ref: > products.id] // Relasi ke products
  quantity integer [not null, default: 1]
  unit_price decimal(12,2) [not null]
  subtotal decimal(12,2) [not null]

  indexes {
    order_id
    product_id
  }

  Note: 'Item rincian belanja dalam setiap pesanan'
}

Table payments {
  id integer [primary key, increment]
  order_id integer [unique, not null, ref: - orders.id] // One-to-One
  payment_method payment_method [not null]
  amount decimal(12,2) [not null]
  payment_status payment_status [default: 'unpaid']
  transaction_time timestamp

  Note: 'Rekam pembayaran untuk setiap order (Relasi 1:1)'
}

// --------------------------------------------------------
// KELOMPOK TABEL (TableGroup di dbdiagram.io)
// --------------------------------------------------------
TableGroup MasterData {
  users
  user_profiles
  categories
  products
}

TableGroup Transaksi {
  orders
  order_items
  payments
}
